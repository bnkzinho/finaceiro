PORT=3000

# Senha única pra acessar o site e a API — invente uma forte. Não é um
# login de usuário de verdade, é só pra ninguém mais ver seus dados
# financeiros se achar a URL.
FINANCEIRO_SENHA=

# Projeto Supabase NOVO, separado dos outros (Project Settings > API).
SUPABASE_URL=
# A chave "service_role" (não a "anon") — Project Settings > API Keys.
# NUNCA exponha essa chave no frontend, só fica aqui no backend.
SUPABASE_SERVICE_ROLE_KEY=

# Conta grátis em dashboard.pluggy.ai (uso pessoal/sandbox) — depois
# Settings > Credentials.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
